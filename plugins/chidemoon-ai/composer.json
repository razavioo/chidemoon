{
  "name": "chidemoon/chidemoon-ai",
  "description": "Independent review-gated editorial AI for Chidemoon WordPress.",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1"
  },
  "scripts": {
    "test": "php tests/state-machine-test.php && php tests/architecture-boundary-test.php",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
