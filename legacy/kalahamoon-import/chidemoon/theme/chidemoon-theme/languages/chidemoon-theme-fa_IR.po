msgid "Body copy must contain at least %d words."
msgstr "متن اصلی باید دست‌کم %d واژه داشته باشد."

msgid "Add a useful excerpt."
msgstr "یک خلاصه مفید اضافه کنید."

msgid "Before publishing"
msgstr "پیش از انتشار"

msgid "Choose at least one category."
msgstr "دست‌کم یک دسته‌بندی انتخاب کنید."

msgid "Use this short checklist before you publish. It does not block WordPress publishing."
msgstr "پیش از انتشار این فهرست کوتاه را بررسی کنید. این مورد مانع انتشار در وردپرس نمی‌شود."

msgid "Writing reminder"
msgstr "یادآوری نگارش"

msgid "Replace pattern guidance with your article copy and source details."
msgstr "راهنمای الگو را با متن مقاله و جزئیات منابع خود جایگزین کنید."

msgid "Add at least one level-two heading."
msgstr "دست‌کم یک عنوان سطح دو اضافه کنید."

msgid "Add a featured image."
msgstr "یک تصویر شاخص اضافه کنید."

msgid "Add alternative text to the featured image."
msgstr "برای تصویر شاخص متن جایگزین اضافه کنید."

msgid "Add at least one external source link."
msgstr "دست‌کم یک پیوند منبع بیرونی اضافه کنید."

msgid "Add alternative text to every inline image."
msgstr "برای همه تصویرهای درون‌متنی متن جایگزین اضافه کنید."

msgid "Add the affiliate disclosure block."
msgstr "بلوک شفاف‌سازی همکاری در فروش را اضافه کنید."

msgid "Chidemoon editorial review"
msgstr "بازبینی تحریریه چیدمون"

msgid "Sources checked on"
msgstr "تاریخ بررسی منابع"

msgid "I reviewed the claims, links, media, disclosure, and product references."
msgstr "ادعاها، پیوندها، رسانه‌ها، شفاف‌سازی و ارجاع‌های محصول را بررسی کرده‌ام."

msgid "Automated editorial checks currently pass."
msgstr "بررسی‌های خودکار تحریریه اکنون با موفقیت انجام می‌شوند."

msgid "Resolve before approval:"
msgstr "پیش از تأیید برطرف کنید:"

msgid "Choose a valid source-check date."
msgstr "یک تاریخ معتبر برای بررسی منابع انتخاب کنید."

msgid "Invalid post ID."
msgstr "شناسه نوشته نامعتبر است."

msgid "Results for “%s”"
msgstr "نتایج برای «%s»"

msgid "Editorial pages"
msgstr "صفحه‌های تحریریه"

msgid "Previous"
msgstr "قبلی"

msgid "Next"
msgstr "بعدی"

msgid "Public review"
msgstr "بازبینی عمومی"

msgid "Needs classification"
msgstr "نیازمند دسته‌بندی"

msgid "Ready for public"
msgstr "آماده برای انتشار عمومی"

msgid "Needs review"
msgstr "نیازمند بازبینی"

msgid "%d content check remaining"
msgid_plural "%d content checks remaining"
msgstr[0] "%d بررسی محتوایی باقی مانده است"

msgid "Review evidence required"
msgstr "مدرک بازبینی لازم است"

msgid "Ready to publish"
msgstr "آماده برای انتشار"

msgid "Chidemoon editorial readiness"
msgstr "آمادگی تحریریه چیدمون"

msgid "Editorial readiness"
msgstr "آمادگی تحریریه"

msgid "You are not allowed to review editorial readiness."
msgstr "اجازه بررسی آمادگی تحریریه را ندارید."

msgid "Published articles that satisfy the public editorial checks."
msgstr "مقاله‌های منتشرشده‌ای که بررسی‌های تحریریه عمومی را گذرانده‌اند."

msgid "Articles that pass review but remain unpublished."
msgstr "مقاله‌هایی که بازبینی را گذرانده‌اند اما هنوز منتشر نشده‌اند."

msgid "Classified articles missing current review evidence or content checks."
msgstr "مقاله‌های دسته‌بندی‌شده‌ای که مدرک بازبینی به‌روز یا بررسی محتوایی ندارند."

msgid "Articles that need an editorial type before they can enter a public route."
msgstr "مقاله‌هایی که پیش از ورود به مسیر عمومی به یک نوع تحریریه نیاز دارند."

msgid "Magazine, guide, and room-story pages only show published articles with current sources and completed editorial checks."
msgstr "صفحه‌های مجله، راهنما و داستان فضا فقط مقاله‌های منتشرشده با منابع به‌روز و بررسی تحریریه کامل را نمایش می‌دهند."

msgid "articles in the editorial queue"
msgstr "مقاله در صف تحریریه"

msgid "Review posts"
msgstr "بررسی مقاله‌ها"

msgid "Buying guide"
msgstr "راهنمای خرید"

msgid "Room story"
msgstr "داستان فضا"

msgid "Review"
msgstr "بررسی"

msgid "Inspiration"
msgstr "الهام"

msgid "Body copy has %1$d of %2$d required words."
msgstr "متن اصلی %1$d واژه از %2$d واژه لازم را دارد."

msgid "Use a date no older than 180 days. Saving this post records the review evidence."
msgstr "تاریخی انتخاب کنید که بیش از ۱۸۰ روز از آن نگذشته باشد. ذخیره این نوشته، مدرک بازبینی را ثبت می‌کند."

msgid "Buying guides are being reviewed."
msgstr "راهنماهای خرید در حال بازبینی هستند."

msgid "We publish buying advice only after its sources and recommendations are current. Explore the magazine while guides are prepared."
msgstr "راهنمای خرید را فقط پس از به‌روز بودن منابع و پیشنهادهای آن منتشر می‌کنیم. تا آماده‌شدن راهنماها، مجله را ببینید."

msgid "No reviewed articles match this search."
msgstr "هیچ مقاله بررسی‌شده‌ای با این جست‌وجو همخوانی ندارد."

msgid "Try a broader search or explore the magazine for related ideas."
msgstr "جست‌وجوی گسترده‌تری انجام دهید یا برای ایده‌های مرتبط مجله را ببینید."

msgid "No reviewed magazine articles are available yet."
msgstr "هنوز مقاله بررسی‌شده‌ای برای مجله آماده نیست."

msgid "We publish magazine articles after their sources and recommendations have been checked."
msgstr "مقاله‌های مجله را پس از بررسی منابع و پیشنهادهایشان منتشر می‌کنیم."
