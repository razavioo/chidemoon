{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": true,
			"palette": [
				{
					"name": "سبز جنگلی اصلی",
					"slug": "forest-green",
					"color": "#12382E"
				},
				{
					"name": "سبز زیتونی ثانویه",
					"slug": "sage-green",
					"color": "#879784"
				},
				{
					"name": "نارنجی اخرایی",
					"slug": "terracotta-orange",
					"color": "#C9683F"
				},
				{
					"name": "کرم ماسه",
					"slug": "warm-cream",
					"color": "#E8DDCD"
				},
				{
					"name": "سفید برفی گرم",
					"slug": "snow-white",
					"color": "#F7F3EA"
				},
				{
					"name": "مشکی کربن",
					"slug": "deep-charcoal",
					"color": "#171A17"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"spacing": {
			"blockGap": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "YekanBakh, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
					"name": "YekanBakh",
					"slug": "yekanbakh"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"name": "System Mono",
					"slug": "system-mono"
				}
			],
			"fontSizes": [
				{
					"size": "0.75rem",
					"name": "بسیار کوچک",
					"slug": "x-small"
				},
				{
					"size": "0.875rem",
					"name": "کوچک",
					"slug": "small"
				},
				{
					"size": "1rem",
					"name": "معمولی",
					"slug": "normal"
				},
				{
					"size": "1.25rem",
					"name": "متوسط",
					"slug": "medium"
				},
				{
					"size": "1.5rem",
					"name": "بزرگ",
					"slug": "large"
				},
				{
					"size": "2.25rem",
					"name": "بسیار بزرگ",
					"slug": "x-large"
				},
				{
					"size": "3rem",
					"name": "نمایشی بزرگ",
					"slug": "xx-large"
				}
			]
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "سربرگ",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "پاورقی",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page",
			"title": "صفحه",
			"postTypes": ["page"]
		},
		{
			"name": "single",
			"title": "نوشته تکی",
			"postTypes": ["post"]
		},
		{
			"name": "archive",
			"title": "آرشیو",
			"postTypes": ["post"]
		},
		{
			"name": "search",
			"title": "نتایج جستجو"
		},
		{
			"name": "404",
			"title": "صفحه یافت نشد"
		}
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--snow-white)",
			"text": "var(--wp--preset--color--forest-green)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--yekanbakh)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--terracotta-orange)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--yekanbakh)",
					"fontWeight": "800",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--forest-green)"
				}
			},
			"button": {
				"border": {
					"radius": "16px",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--forest-green)"
				},
				"color": {
					"background": "var(--wp--preset--color--forest-green)",
					"text": "var(--wp--preset--color--snow-white)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--terracotta-orange)",
						"text": "var(--wp--preset--color--snow-white)"
					},
					"border": {
						"color": "var(--wp--preset--color--terracotta-orange)"
					}
				}
			}
		}
	}
}
