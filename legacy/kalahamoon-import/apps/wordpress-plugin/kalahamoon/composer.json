{
  "name": "kalahamoon/wordpress-plugin",
  "description": "Kalahamoon WordPress plugin — affiliate content toolkit",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "brain/monkey": "^2",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Kalahamoon\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:syntax": "vendor/bin/phpunit --testsuite=Syntax",
    "test:unit": "vendor/bin/phpunit --testsuite=Unit"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  }
}
