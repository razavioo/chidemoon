{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kalahamoon/comparison-table",
	"version": "1.1.0",
	"title": "Kalahamoon Comparison Table",
	"category": "kalahamoon",
	"icon": "editor-table",
	"description": "Side-by-side product comparison table with specs, prices, and CTA buttons.",
	"keywords": ["compare", "comparison", "table", "مقایسه"],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"color": {
			"background": true,
			"text": true,
			"__experimentalDefaultControls": { "background": false }
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"style": true,
			"__experimentalDefaultControls": { "radius": true }
		}
	},
	"attributes": {
		"productIds": { "type": "string", "default": "" },
		"specs": { "type": "string", "default": "" }
	},
	"example": {
		"attributes": {}
	},
	"textdomain": "kalahamoon",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
