{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kalahamoon/ai-compare",
	"version": "1.1.0",
	"title": "AI Product Comparison",
	"category": "kalahamoon",
	"icon": "chart-bar",
	"description": "Side-by-side AI-generated comparison of two products with pros, cons, per-criterion winners, and a verdict. Uses Kalahamoon AI.",
	"keywords": ["ai", "compare", "comparison", "review", "verdict", "مقایسه", "هوش مصنوعی"],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"color": {
			"background": true,
			"text": true,
			"__experimentalDefaultControls": { "background": false }
		},
		"typography": {
			"fontSize": true,
			"fontFamily": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"__experimentalDefaultControls": { "radius": true }
		}
	},
	"attributes": {
		"productIds": { "type": "string", "default": "" },
		"criteria": { "type": "string", "default": "" },
		"language": { "type": "string", "default": "fa", "enum": ["fa", "ar", "en"] },
		"comparison": { "type": "string", "default": "" },
		"products": { "type": "string", "default": "" },
		"generatedAt": { "type": "string", "default": "" },
		"ctaText": { "type": "string", "default": "View product" },
		"showHeads": { "type": "boolean", "default": true },
		"showCriteria": { "type": "boolean", "default": true },
		"showProsCons": { "type": "boolean", "default": true },
		"showVerdict": { "type": "boolean", "default": true }
	},
	"example": {
		"attributes": {
			"language": "en",
			"showHeads": true,
			"showCriteria": true,
			"showProsCons": true,
			"showVerdict": true
		}
	},
	"textdomain": "kalahamoon",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
