{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kalahamoon/product-comparison",
	"version": "1.0.0",
	"title": "Kalahamoon Product Comparison",
	"category": "kalahamoon",
	"icon": "columns",
	"description": "A public comparison surface for two to four verified products of the same comparison type.",
	"keywords": ["compare", "products", "table"],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": { "padding": true, "margin": true }
	},
	"attributes": {
		"productIds": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"showDisclosure": { "type": "boolean", "default": true }
	},
	"example": { "attributes": { "heading": "Compare products" } },
	"textdomain": "kalahamoon",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style.css"
}
