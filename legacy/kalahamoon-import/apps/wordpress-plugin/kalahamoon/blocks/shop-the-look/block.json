{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kalahamoon/shop-the-look",
	"version": "1.1.0",
	"title": "Shop the Look",
	"category": "kalahamoon",
	"icon": "camera",
	"description": "Lifestyle image with clickable product hotspots — hover or tap to reveal product cards.",
	"keywords": ["shop", "look", "hotspot", "image", "lifestyle", "affiliate", "استایل", "تصویر"],
	"supports": {
		"html": false,
		"anchor": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true,
			"__experimentalDefaultControls": { "radius": true }
		},
		"shadow": true,
		"dimensions": { "minHeight": true }
	},
	"attributes": {
		"imageUrl": { "type": "string", "default": "" },
		"imageAlt": { "type": "string", "default": "" },
		"imageId": { "type": "integer", "default": 0 },
		"hotspots": { "type": "string", "default": "[]" },
		"caption": { "type": "string", "default": "" },
		"displayStyle": { "type": "string", "default": "hotspots" }
	},
	"example": {
		"attributes": {
			"caption": "Shop the look — tap a hotspot to view the product"
		}
	},
	"textdomain": "kalahamoon",
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js"
}
