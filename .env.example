# Copy to .env and replace every value before starting a non-local environment.
CHIDEMOON_HTTP_PORT=18098
CHIDEMOON_SITE_URL=http://localhost:18098
CHIDEMOON_ENVIRONMENT=local
CHIDEMOON_DB_NAME=chidemoon
CHIDEMOON_DB_USER=chidemoon
CHIDEMOON_DB_PASSWORD=replace-with-a-long-unique-database-password
CHIDEMOON_DB_ROOT_PASSWORD=replace-with-a-different-long-root-password
CHIDEMOON_ADMIN_USER=chidemoon-editor
CHIDEMOON_ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
CHIDEMOON_ADMIN_EMAIL=editor@example.test
CHIDEMOON_WP_DEBUG=0
CHIDEMOON_BACKUP_RETENTION_DAYS=14
CHIDEMOON_AI_PROVIDER_BASE_URL=https://api.openai.com/v1
CHIDEMOON_AI_API_KEY=replace-with-a-chidemoon-owned-provider-key
CHIDEMOON_AI_TEXT_MODEL=gpt-4.1-mini
CHIDEMOON_AI_IMAGE_MODEL=gpt-image-2
CHIDEMOON_AI_PROVIDER_TIMEOUT=60
CHIDEMOON_AI_MODERATION_MODEL=omni-moderation-latest
CHIDEMOON_AI_MODERATION_TIMEOUT=30
CHIDEMOON_AI_DAILY_REQUEST_LIMIT=25
CHIDEMOON_AI_MONTHLY_REQUEST_LIMIT=500
CHIDEMOON_AI_MONTHLY_BUDGET=25
CHIDEMOON_AI_TEXT_ESTIMATED_COST=0.02
CHIDEMOON_AI_COMPARISON_ESTIMATED_COST=0.04
CHIDEMOON_AI_IMAGE_ESTIMATED_COST=0.06
CHIDEMOON_AI_EVIDENCE_MAX_AGE_DAYS=90
